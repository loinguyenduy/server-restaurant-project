NODE_ENV=development
PORT=8080

# Railway production preference: MYSQL_URL=${{mysql.MYSQL_URL}}
MYSQL_URL=

# Local/manual MySQL fallback (used only when MYSQL_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=royal_restaurant
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# Replace both JWT secrets with different, long random values in production
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=10h
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
COOKIE_REFRESH_MAX_AGE=604800000

CLOUDINARY_NAME=replace-with-cloud-name
CLOUDINARY_KEY=replace-with-cloudinary-key
CLOUDINARY_SECRET=replace-with-cloudinary-secret

PAYOS_CLIENT_ID=replace-with-payos-client-id
PAYOS_API_KEY=replace-with-payos-api-key
PAYOS_CHECKSUM_KEY=replace-with-payos-checksum-key
PAYOS_RETURN_URL=http://localhost:3000/payment-success
PAYOS_CANCEL_URL=http://localhost:3000/payment-cancel
PAYOS_ORDER_TIMEOUT_MINUTES=30
LOW_STOCK_THRESHOLD=5
